# Copy to .env and fill in only what you use. Never commit .env.

# Optional: ElevenLabs sound effects, voice and music generation.
ELEVENLABS_API_KEY=

# Optional: Poly Pizza API (low-poly 3D models), from poly.pizza/settings/api.
# Server/tool side only: never put it in public/ (the browser would expose it).
POLY_PIZZA_API_KEY=

# Optional: only needed if you deploy without `npx wrangler login`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

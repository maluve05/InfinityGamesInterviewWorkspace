{
  // Static-assets Worker serving public/. No build step.
  // No account_id here: `npx wrangler login` (or CLOUDFLARE_ACCOUNT_ID in .env) supplies it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinity-games-interview",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Keep the workers.dev URL as a fallback link (adding routes disables it otherwise).
  "workers_dev": true,
  "routes": [
    { "pattern": "infinity.chitswa.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  // Set up 2026-11-07 before the window. Unused until a Worker script ("main") reads
  // them; an assets-only deploy with these bindings passes `wrangler deploy --dry-run`.
  "d1_databases": [
    { "binding": "DB", "database_name": "infinitytelemetry", "database_id": "ca0dc333-a2ef-489b-9f3e-c1c120c451ca" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "infinity-assets" }
  ]
}
